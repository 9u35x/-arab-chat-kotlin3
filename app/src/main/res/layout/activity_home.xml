<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bgBase">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/amoledBlack"
        android:paddingStart="18dp"
        android:paddingEnd="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/textPrimaryDark"
            android:textSize="19sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChannels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/channels_short"
            android:textColor="@color/colorAccent"
            android:textSize="13sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvProfile"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="👤"
            android:textColor="@color/textOnAccent"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvSettings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/textSecondaryDark"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/logout"
            android:textColor="@color/errorRed"
            android:textSize="13sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <EditText
        android:id="@+id/etSearchChats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="@string/search_unified_hint"
        android:textColor="@color/textPrimaryDark"
        android:textColorHint="@color/textTertiaryDark"
        android:padding="12dp"
        android:textSize="14sp"
        android:singleLine="true"
        android:inputType="text"
        android:textCursorDrawable="@null" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


    <LinearLayout
        android:id="@+id/layoutStoriesBar"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:orientation="vertical"
        android:background="#120E1A"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="القصص"
            android:textColor="#9B8FB5"
            android:textSize="12sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="2dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHomeStories"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </LinearLayout>

<androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="80dp" />

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_chats_yet"
            android:textColor="@color/textTertiaryDark"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fabNewChat"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:background="@drawable/bg_fab_gradient"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/textOnAccent"
            android:textSize="28sp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="8dp" />
    </FrameLayout>
</LinearLayout>
