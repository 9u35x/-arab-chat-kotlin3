<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/ivStory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <VideoView
        android:id="@+id/vvStory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- أعلى -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#99000000"
        android:paddingTop="28dp"
        android:paddingBottom="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCloseStory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:id="@+id/tvStoryUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvStoryViews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E8E0F5"
                    android:textSize="13sp"
                    android:text="👁 0 مشاهدة" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStoryMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⋮"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:padding="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStoryCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F5F5F5"
            android:textSize="14sp"
            android:paddingTop="6dp"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- أسفل -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#99000000"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvHeart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤍"
                android:textSize="30sp"
                android:padding="6dp" />

            <TextView
                android:id="@+id/tvHeartCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:minWidth="24dp" />

            <TextView
                android:id="@+id/tvViewsBig"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="#B983FF"
                android:textSize="14sp"
                android:text="👁 0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etStoryReply"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:hint="رد على القصة..."
                android:textColorHint="#99FFFFFF"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="14dp"
                android:background="#33FFFFFF"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvSendReply"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="إرسال"
                android:textColor="#B983FF"
                android:textSize="15sp"
                android:paddingHorizontal="14dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
