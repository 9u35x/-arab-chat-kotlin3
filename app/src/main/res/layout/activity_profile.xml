<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgBase"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/amoledBlack"
            android:paddingStart="8dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="→"
                android:textColor="@color/textPrimaryDark"
                android:textSize="22sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvProfileTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_title"
                android:textColor="@color/textPrimaryDark"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />

            <View
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>

        <!-- Avatar section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="28dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp">

                <TextView
                    android:id="@+id/tvProfileAvatar"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:textColor="@color/colorAccent"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:text="?" />

                <ImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <ProgressBar
                    android:id="@+id/progressPhoto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvChangePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/change_photo"
                android:textColor="@color/colorAccent"
                android:textSize="14sp"
                android:padding="8dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

            <!-- Legacy name (used briefly / groups) -->
            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/textPrimaryDark"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvProfileSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/textSecondaryDark"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- CONTACT VIEW: separate read-only fields -->
        <LinearLayout
            android:id="@+id/layoutContactFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/display_name_label"
                android:textColor="@color/textSecondaryDark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvContactName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:padding="14dp"
                android:textColor="@color/textPrimaryDark"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="—" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/username_label"
                android:textColor="@color/textSecondaryDark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvContactUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:padding="14dp"
                android:textColor="@color/colorAccent"
                android:textSize="15sp"
                android:text="—" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/bio_label"
                android:textColor="@color/textSecondaryDark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvContactBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:padding="14dp"
                android:textColor="@color/textPrimaryDark"
                android:textSize="15sp"
                android:minLines="2"
                android:text="—" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/gender_label"
                android:textColor="@color/textSecondaryDark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvContactGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:padding="14dp"
                android:textColor="@color/textPrimaryDark"
                android:textSize="15sp"
                android:text="—" />
        </LinearLayout>

        <!-- OWN PROFILE: editable separate fields -->
        <LinearLayout
            android:id="@+id/layoutOwnFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/display_name_label"
                android:textColor="@color/textSecondaryDark"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/display_name_hint"
                android:textColor="@color/textPrimaryDark"
                android:textColorHint="@color/textTertiaryDark"
                android:padding="14dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:textCursorDrawable="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/username_label"
                android:textColor="@color/textSecondaryDark"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/username_at_hint"
                android:textColor="@color/textPrimaryDark"
                android:textColorHint="@color/textTertiaryDark"
                android:padding="14dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:inputType="text"
                android:textCursorDrawable="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/bio_label"
                android:textColor="@color/textSecondaryDark"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/bio_hint"
                android:textColor="@color/textPrimaryDark"
                android:textColorHint="@color/textTertiaryDark"
                android:padding="14dp"
                android:textSize="15sp"
                android:minLines="3"
                android:maxLines="5"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:textCursorDrawable="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/gender_label"
                android:textColor="@color/textSecondaryDark"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/radioGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gender_male"
                    android:textColor="@color/textPrimaryDark" />

                <RadioButton
                    android:id="@+id/radioFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="@string/gender_female"
                    android:textColor="@color/textPrimaryDark" />
            </RadioGroup>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp">

                <TextView
                    android:id="@+id/tvSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_button"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="@string/save"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <ProgressBar
                    android:id="@+id/progressSave"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvOpenSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/settings"
                android:textColor="@color/colorAccent"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvLogoutProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/logout"
                android:textColor="#FF5C7A"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
