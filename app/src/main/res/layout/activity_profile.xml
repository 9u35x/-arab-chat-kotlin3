<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgBase"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#0A0710"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="→"
                android:textColor="@color/textPrimaryDark"
                android:textSize="22sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvProfileTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_title"
                android:textColor="@color/textPrimaryDark"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>

        <!-- Avatar -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp">

            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_avatar_ring" />

            <TextView
                android:id="@+id/tvProfileAvatar"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:textColor="@color/colorAccent"
                android:textSize="36sp"
                android:textStyle="bold"
                android:text="?" />

            <ImageView
                android:id="@+id/ivProfileAvatar"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ProgressBar
                android:id="@+id/progressPhoto"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvChangePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="@string/change_photo"
            android:textColor="@color/colorAccent"
            android:textSize="14sp"
            android:padding="8dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <!-- Display name (both modes can use) -->
        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/textPrimaryDark"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvProfileSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/textSecondaryDark"
            android:textSize="13sp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:visibility="gone" />

        <!-- ===== CONTACT (other person) modern cards ===== -->
        <LinearLayout
            android:id="@+id/layoutContactFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:visibility="gone">

            <!-- Username row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_profile_info_row"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/username_label"
                    android:textColor="@color/textTertiaryDark"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvContactUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/colorAccent"
                    android:textSize="16sp"
                    android:text="—" />
            </LinearLayout>

            <!-- Name row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_profile_info_row"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/display_name_label"
                    android:textColor="@color/textTertiaryDark"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvContactName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/textPrimaryDark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="—" />
            </LinearLayout>

            <!-- Gender row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_profile_info_row"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gender_label"
                    android:textColor="@color/textTertiaryDark"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvContactGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/textPrimaryDark"
                    android:textSize="16sp"
                    android:text="—" />
            </LinearLayout>

            <!-- Bio row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_profile_info_row"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bio_label"
                    android:textColor="@color/textTertiaryDark"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvContactBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/textPrimaryDark"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:text="—" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== OWN PROFILE editable ===== -->
        <LinearLayout
            android:id="@+id/layoutOwnFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/display_name_label"
                android:textColor="@color/textSecondaryDark"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/display_name_hint"
                android:textColor="@color/textPrimaryDark"
                android:textColorHint="@color/textTertiaryDark"
                android:padding="14dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:textCursorDrawable="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/username_label"
                android:textColor="@color/textSecondaryDark"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/username_at_hint"
                android:textColor="@color/textPrimaryDark"
                android:textColorHint="@color/textTertiaryDark"
                android:padding="14dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:textCursorDrawable="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/bio_label"
                android:textColor="@color/textSecondaryDark"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/bio_hint"
                android:textColor="@color/textPrimaryDark"
                android:textColorHint="@color/textTertiaryDark"
                android:padding="14dp"
                android:textSize="15sp"
                android:minLines="3"
                android:maxLines="5"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:textCursorDrawable="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/gender_label"
                android:textColor="@color/textSecondaryDark"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/radioGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gender_male"
                    android:textColor="@color/textPrimaryDark" />

                <RadioButton
                    android:id="@+id/radioFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="@string/gender_female"
                    android:textColor="@color/textPrimaryDark" />
            </RadioGroup>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp">

                <TextView
                    android:id="@+id/tvSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_button"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="@string/save"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <ProgressBar
                    android:id="@+id/progressSave"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvOpenSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/settings"
                android:textColor="@color/colorAccent"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvLogoutProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/logout"
                android:textColor="#FF5C7A"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
