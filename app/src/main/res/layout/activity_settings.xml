<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgBase"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/amoledBlack"
            android:paddingStart="8dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="→"
                android:textColor="@color/textPrimaryDark"
                android:textSize="22sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textColor="@color/textPrimaryDark"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />

            <View
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>

        <!-- Notifications -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surfaceElevated"
            android:layout_marginTop="16dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notifications_label"
                    android:textColor="@color/textPrimaryDark"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/notifications_hint"
                    android:textColor="@color/textSecondaryDark"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/colorAccent"
                android:trackTint="@color/surfaceElevated2" />
        </LinearLayout>

        <!-- Open profile -->
        <TextView
            android:id="@+id/tvOpenProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@color/surfaceElevated"
            android:padding="16dp"
            android:text="@string/my_profile"
            android:textColor="@color/textPrimaryDark"
            android:textSize="15sp"
            android:drawableEnd="@android:drawable/ic_menu_edit"
            android:clickable="true"
            android:focusable="true" />

        <!-- About -->
        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@color/surfaceElevated"
            android:padding="16dp"
            android:text="@string/about_title"
            android:textColor="@color/textPrimaryDark"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Privacy -->
        <TextView
            android:id="@+id/tvPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@color/surfaceElevated"
            android:padding="16dp"
            android:text="@string/privacy_title"
            android:textColor="@color/textPrimaryDark"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Clear cache -->
        <TextView
            android:id="@+id/tvClearCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@color/surfaceElevated"
            android:padding="16dp"
            android:text="@string/clear_cache"
            android:textColor="@color/textPrimaryDark"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Logout -->
        <TextView
            android:id="@+id/tvLogoutSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/logout"
            android:textColor="@color/errorRed"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:textColor="@color/textTertiaryDark"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
