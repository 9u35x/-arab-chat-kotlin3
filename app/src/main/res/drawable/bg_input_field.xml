<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surfaceElevated2" />
            <corners android:radius="28dp" />
            <stroke android:width="1.5dp" android:color="@color/colorAccent" />
            <padding android:left="20dp" android:right="20dp" android:top="14dp" android:bottom="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surfaceElevated" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="@color/glassStroke" />
            <padding android:left="20dp" android:right="20dp" android:top="14dp" android:bottom="14dp" />
        </shape>
    </item>
</selector>
