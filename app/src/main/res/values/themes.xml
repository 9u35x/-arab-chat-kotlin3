<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ArabChat" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSurface">@color/surfaceElevated</item>
        <item name="colorOnSurface">@color/textPrimaryDark</item>
        <item name="colorOnPrimary">@color/textOnAccent</item>
        <item name="colorOnBackground">@color/textPrimaryDark</item>
        <item name="android:windowBackground">@color/bgBase</item>
        <item name="android:navigationBarColor">@color/amoledBlack</item>
        <item name="android:statusBarColor">@color/amoledBlack</item>
        <item name="android:textColorPrimary">@color/textPrimaryDark</item>
        <item name="android:textColorSecondary">@color/textSecondaryDark</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.ArabChat.Splash" parent="Theme.ArabChat">
        <item name="android:windowBackground">@drawable/bg_splash_gradient</item>
    </style>
</resources>
